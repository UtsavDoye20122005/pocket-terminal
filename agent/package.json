{
  "name": "pocket-terminal-agent",
  "version": "5.0.0",
  "private": true,
  "description": "Runs on your Mac or Windows PC. Lets your phone use its terminal directly (P2P), even with the lid closed.",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "pair": "node pair.js",
    "test": "node test/power.test.js && node test/windows.test.js && node ../test/crypto-board.test.js",
    "postinstall": "node -e \"try{require('fs').chmodSync(require.resolve('node-pty/package.json').replace('package.json','prebuilds/'+process.platform+'-'+process.arch+'/spawn-helper'),0o755)}catch(e){}\""
  },
  "dependencies": {
    "node-datachannel": "0.33.4",
    "node-pty": "1.1.0",
    "qrcode-terminal": "0.12.0",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=18.20"
  }
}
